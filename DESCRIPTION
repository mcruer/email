Package: email
Type: Package
Title: Send and Read Outlook Email from R
Version: 0.1.2
Authors@R:
    person("Geordie", "McRuer", , "geo.mcruer@gmail.com", role = c("aut", "cre"))
Description: Sends email through Microsoft Outlook and reads messages from Outlook folders,
    using the Windows COM interface ('RDCOMClient'). Used by the 'tina' package
    for every report, reminder and alert it emails.
License: GPL-3
Encoding: UTF-8
LazyData: true
Depends:
    RDCOMClient
Imports:
    purrr,
    tibble,
    magrittr,
    dplyr,
    rlang,
    tidyr,
    tidyselect
RoxygenNote: 7.3.3
